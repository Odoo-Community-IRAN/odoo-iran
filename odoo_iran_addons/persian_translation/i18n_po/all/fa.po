"<span style=\"font-size: 14px;\">\n"
"                    Add a checklist\n"
"                    (/<span style=\"font-style: italic;\">checklist</span>)\n"
"                </span>"
msgstr ""
"<span style=\"font-size: 14px;\">\n"
"                    یک چک لیست اضافه کنید\n"
"                    (/<span style=\"font-style: italic;\">چک لیست</span>)\n"
"                </span>"

#. modules: knowledge, project_todo
#: model_terms:ir.ui.view,arch_db:knowledge.knowledge_article_user_onboarding model_terms:ir.ui.view,arch_db:project_todo.todo_user_onboarding
